<?xml version="1.0" encoding="utf-8"?>
<!--
    自适应图标（minSdk 26，所有机型都走这份）。前景 ic_launcher_foreground.png（432×432，108dp@4x）：
    下方书本从 pdf-reader 的图标前景原样剪下、原位置不变；上方原来"PDF"字样的位置换成
    "一句话"横条（同款蓝色渐变 #3049C4→#2B40A9）+ 琥珀色句号（同闪电配色 #F2A823→#CE8710）。
    monochrome 给安卓 13+ 的"主题图标"用，系统按透明度单色染色。
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
